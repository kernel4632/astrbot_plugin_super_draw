{
  "enabled": {
    "description": "启用生图",
    "hint": "总开关，关闭后所有生图命令和 LLM 工具都不可用",
    "type": "bool",
    "default": true
  },
  "enable_llm_tool": {
    "description": "启用 LLM 工具",
    "hint": "允许 Bot 自动调用 super_draw 工具生图；关闭后只能用 /生图 命令",
    "type": "bool",
    "default": true
  },
  "ban_list": {
    "description": "生图黑名单",
    "hint": "填写用户 ID，黑名单中的用户无法使用生图功能；Bot 工具可通过 super_draw_ban 管理",
    "type": "list",
    "default": []
  },
  "debug_mode": {
    "description": "调试模式",
    "hint": "开启后会在日志中输出更多调试信息",
    "type": "bool",
    "default": false
  },
  "api_providers": {
    "description": "API 供应商配置",
    "hint": "支持 OpenAI 兼容接口和 Gemini 官方接口，可添加多个供应商和模型",
    "type": "template_list",
    "templates": {
      "openai": {
        "name": "OpenAI 兼容接口",
        "hint": "适用于 OpenAI、硅基流动、DeepSeek 等兼容接口",
        "display_item": "name",
        "items": {
          "name": {
            "description": "供应商名称",
            "hint": "用来区分不同供应商，例如 GPT-Image、硅基流动",
            "type": "string",
            "default": "OpenAI"
          },
          "api_type": {
            "description": "接口类型",
            "type": "string",
            "default": "openai",
            "options": [
              "openai",
              "gemini"
            ]
          },
          "base_url": {
            "description": "请求地址",
            "hint": "OpenAI 兼容接口的 Base URL，不需要带 /v1",
            "type": "string",
            "default": "https://api.openai.com"
          },
          "api_keys": {
            "description": "API Keys",
            "hint": "多个 Key 会自动轮换使用",
            "type": "list",
            "default": []
          },
          "available_models": {
            "description": "可用模型列表",
            "hint": "填写该供应商支持的生图模型名称",
            "type": "list",
            "default": []
          }
        }
      },
      "gemini": {
        "name": "Gemini 官方接口",
        "hint": "适用于 Google Gemini 官方生图 API",
        "display_item": "name",
        "items": {
          "name": {
            "description": "供应商名称",
            "hint": "用来区分不同供应商",
            "type": "string",
            "default": "Gemini"
          },
          "api_type": {
            "description": "接口类型",
            "type": "string",
            "default": "gemini",
            "options": [
              "openai",
              "gemini"
            ]
          },
          "base_url": {
            "description": "请求地址",
            "hint": "留空使用官方地址；如果用代理填代理地址",
            "type": "string",
            "default": ""
          },
          "api_keys": {
            "description": "API Keys",
            "hint": "多个 Key 会自动轮换使用",
            "type": "list",
            "default": []
          },
          "available_models": {
            "description": "可用模型列表",
            "hint": "填写 Gemini 生图模型名称",
            "type": "list",
            "default": [
              "gemini-2.0-flash-exp-image-generation"
            ]
          }
        }
      }
    }
  },
  "generation": {
    "description": "生图配置",
    "hint": "控制生图行为的核心参数",
    "type": "object",
    "items": {
      "model": {
        "description": "当前生图模型",
        "hint": "格式为 供应商名/模型名，留空自动选第一个可用模型",
        "type": "string",
        "default": ""
      },
      "max_retry_attempts": {
        "description": "最大重试次数",
        "hint": "单次生图请求失败后的最大重试次数",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      },
      "timeout": {
        "description": "生图超时时间（秒）",
        "hint": "单次 API 请求的超时时间",
        "type": "int",
        "default": 180,
        "slider": {
          "min": 30,
          "max": 600,
          "step": 10
        }
      },
      "max_queue_size": {
        "description": "最大队列长度",
        "hint": "同时允许排队的生图任务数量，超过后拒绝新任务",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 1,
          "max": 100,
          "step": 1
        }
      }
    }
  },
  "points": {
    "description": "积分制",
    "hint": "通过积分控制生图使用频率，群友发言赚积分，生图消耗积分",
    "type": "object",
    "items": {
      "enable_points": {
        "description": "启用积分制",
        "hint": "关闭后生图不消耗积分，所有人都可以无限使用",
        "type": "bool",
        "default": true
      },
      "points_per_message": {
        "description": "每次有效发言获得积分",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 0,
          "max": 50,
          "step": 1
        }
      },
      "message_point_cooldown_seconds": {
        "description": "发言加分冷却（秒）",
        "hint": "同一用户在冷却时间内只算一次有效发言",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 0,
          "max": 3600,
          "step": 5
        }
      },
      "draw_cost_per_image": {
        "description": "每次生图消耗积分",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        }
      },
      "bad_request_penalty_points": {
        "description": "400错误扣除积分",
        "hint": "生图因内容安全等原因返回 400 时额外扣除的积分，余额最低为 0",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        }
      },
      "new_user_points": {
        "description": "新用户初始积分",
        "hint": "第一次见到用户时赠送的积分",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 1000,
          "step": 5
        }
      },
      "enable_data_tools": {
        "description": "Bot 数据工具",
        "hint": "允许 LLM 通过 super_draw_data 工具查询和修改积分数据",
        "type": "bool",
        "default": true
      }
    }
  },
  "commentary": {
    "description": "生图后评价",
    "hint": "仅在 LLM 工具调用 super_draw 生图成功后触发，用户命令生图不触发",
    "type": "object",
    "items": {
      "enable_commentary": {
        "description": "启用工具生图后评价",
        "hint": "Bot 通过工具生图成功后，会结合上下文自然评价图片",
        "type": "bool",
        "default": true
      },
      "commentary_provider_id": {
        "description": "生图后评价模型",
        "hint": "填写 AstrBot 已配置的聊天模型 provider_id；留空使用当前会话模型",
        "type": "string",
        "default": ""
      },
      "commentary_template": {
        "description": "生图后评价模板",
        "hint": "可用变量：{prompt} 用户需求、{model} 生图模型、{context} 会话历史、{images} 图片信息、{max_length} 最大字数",
        "type": "text",
        "default": "你是群聊里的 Bot，刚刚完成了一次生图。结合群聊上下文和用户需求，自然接一句短回复。\n用户需求：{prompt}\n使用模型：{model}\n群聊上下文：\n{context}\n图片信息：\n{images}\n要求：最多 {max_length} 字，像群友聊天一样自然。"
      },
      "commentary_max_length": {
        "description": "生图后评价最大字数",
        "hint": "控制 Bot 追评长度，避免刷屏",
        "type": "int",
        "default": 150,
        "slider": {
          "min": 20,
          "max": 500,
          "step": 10
        }
      }
    }
  },
  "presets": {
    "description": "预设配置",
    "hint": "预设提示词，用户可通过 /生图预设 管理，也可在此处预配置",
    "type": "template_list",
    "templates": {
      "preset": {
        "name": "预设项",
        "display_item": "name",
        "items": {
          "name": {
            "description": "预设名称",
            "hint": "用户输入 /生图 预设名称 描述 时会自动套用",
            "type": "string",
            "default": ""
          },
          "prompt": {
            "description": "提示词内容",
            "hint": "预设的完整提示词，会追加在用户描述前面",
            "type": "text",
            "default": ""
          }
        }
      }
    }
  }
}