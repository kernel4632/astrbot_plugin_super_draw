{
  "enabled": {
    "description": "启用生图",
    "hint": "总开关，关闭后所有生图命令和 LLM 工具都不可用",
    "type": "bool",
    "default": true
  },
  "enable_llm_tool": {
    "description": "启用 LLM 工具",
    "hint": "允许 Bot 自动调用 super_draw 工具生图；关闭后只能用 /生图 命令",
    "type": "bool",
    "default": true
  },
  "ban_list": {
    "description": "生图黑名单",
    "hint": "填写用户 QQ 号，例如 123456789；黑名单中的用户无法使用生图功能（Bot 也可通过 super_draw_ban 工具管理）",
    "type": "list",
    "default": [],
    "obvious_hint": true
  },
  "debug_mode": {
    "description": "调试模式",
    "hint": "开启后会在日志中输出更多调试信息",
    "type": "bool",
    "default": false
  },
  "rich_task_feedback": {
    "description": "使用引用回复反馈生图任务",
    "hint": "开启后，任务完成、失败和取消时引用原始生图消息；不支持引用时自动退回文字",
    "type": "bool",
    "default": false
  },
  "api_providers": {
    "description": "API 供应商配置",
    "hint": "支持 OpenAI 兼容接口和 Gemini 官方接口，可添加多个供应商和模型；每个条目的「供应商名称」请保持唯一，否则面板里无法区分",
    "type": "template_list",
    "templates": {
      "openai": {
        "name": "OpenAI 兼容接口",
        "hint": "适用于 OpenAI、硅基流动、各类中转站的图片接口或对话接口",
        "display_item": "name",
        "items": {
          "name": {
            "description": "供应商名称",
            "hint": "用来区分不同供应商，例如 GPT-Image、硅基流动；务必唯一，面板折叠后只显示这个名字",
            "type": "string",
            "default": "OpenAI"
          },
          "api_type": {
            "description": "接口类型",
            "hint": "openai：调用 /v1/images/generations 与 /v1/images/edits；openai_chat：调用 /v1/chat/completions 出图（部分中转站只支持这种）；gemini：Gemini 原生接口，建议改用右侧「Gemini 官方接口」模板",
            "type": "string",
            "default": "openai",
            "options": [
              "openai",
              "openai_chat",
              "gemini"
            ],
            "labels": [
              "图片接口 /images/*",
              "对话接口 /chat/completions 出图",
              "Gemini 原生接口"
            ]
          },
          "base_url": {
            "description": "请求地址",
            "hint": "OpenAI 兼容接口的 Base URL，不需要带 /v1",
            "type": "string",
            "default": "https://api.openai.com"
          },
          "api_keys": {
            "description": "API Keys",
            "hint": "多个 Key 会自动轮换使用；面板会明文显示，注意保密",
            "type": "list",
            "default": []
          },
          "available_models": {
            "description": "可用模型列表",
            "hint": "填写该供应商支持的生图模型名称",
            "type": "list",
            "default": []
          }
        }
      },
      "gemini": {
        "name": "Gemini 官方接口",
        "hint": "适用于 Google Gemini 官方生图 API 或代理",
        "display_item": "name",
        "items": {
          "name": {
            "description": "供应商名称",
            "hint": "用来区分不同供应商，例如 Gemini 官方、XX 中转",
            "type": "string",
            "default": "Gemini"
          },
          "api_type": {
            "description": "接口类型",
            "hint": "该模板固定使用 Gemini 原生 generateContent 接口",
            "type": "string",
            "default": "gemini",
            "options": [
              "gemini"
            ],
            "labels": [
              "Gemini 原生接口 generateContent"
            ]
          },
          "base_url": {
            "description": "请求地址",
            "hint": "留空使用官方地址；如果用代理填代理地址",
            "type": "string",
            "default": ""
          },
          "api_keys": {
            "description": "API Keys",
            "hint": "多个 Key 会自动轮换使用；面板会明文显示，注意保密",
            "type": "list",
            "default": []
          },
          "available_models": {
            "description": "可用模型列表",
            "hint": "填写 Gemini 生图模型名称",
            "type": "list",
            "default": [
              "gemini-3.1-flash-image-preview"
            ]
          }
        }
      }
    }
  },
  "generation": {
    "description": "生图配置",
    "hint": "控制生图行为的核心参数",
    "type": "object",
    "items": {
      "model": {
        "description": "当前生图模型",
        "hint": "格式必须为「供应商名/模型名」，例如 AKer/gpt-image-2-only；留空或填错都会自动改用第一个可用模型。也可以直接在群里用 /生图模型 切换",
        "type": "string",
        "default": "",
        "obvious_hint": true
      },
      "max_retry_attempts": {
        "description": "最大重试次数",
        "hint": "单次生图请求失败后的最大重试次数",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      },
      "timeout": {
        "description": "生图超时时间（秒）",
        "hint": "单次 API 请求的超时时间；任务总时限约为「超时 × 重试次数 + 60 秒」，即 600 秒 × 1 次重试 ≈ 等待 11 分钟",
        "type": "int",
        "default": 600,
        "slider": {
          "min": 30,
          "max": 600,
          "step": 10
        }
      },
      "max_active_jobs": {
        "description": "最大同时生图数",
        "hint": "同时运行的生图任务数量，超过后拒绝新任务",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        }
      },
      "max_reference_images": {
        "description": "参考图数量上限",
        "hint": "0 表示不限制。图片过多时部分模型接口可能报错，可按需限制",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 50,
          "step": 1
        }
      }
    }
  },
  "points": {
    "description": "积分制",
    "hint": "通过积分控制生图使用频率，群友发言赚积分，生图消耗积分",
    "type": "object",
    "items": {
      "enable_points": {
        "description": "启用积分制",
        "hint": "关闭后生图不消耗积分，所有人都可以无限使用",
        "type": "bool",
        "default": true
      },
      "points_per_message": {
        "description": "每次有效发言获得积分",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 0,
          "max": 50,
          "step": 1
        },
        "condition": {
          "enable_points": true
        }
      },
      "message_point_cooldown_seconds": {
        "description": "发言加分冷却（秒）",
        "hint": "同一用户在冷却时间内只算一次有效发言",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 0,
          "max": 3600,
          "step": 5
        },
        "condition": {
          "enable_points": true
        }
      },
      "draw_cost_per_image": {
        "description": "每次生图消耗积分",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "condition": {
          "enable_points": true
        }
      },
      "bad_request_penalty_points": {
        "description": "内容策略拒绝扣分",
        "hint": "仅 API 明确返回内容安全或策略拒绝时扣除积分。普通 400、参数错误、网络错误和超时都会退款；建议不超过单次生图消耗的 2~3 倍，误判代价小一些",
        "type": "int",
        "default": 50,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "condition": {
          "enable_points": true
        }
      },
      "new_user_points": {
        "description": "新用户初始积分",
        "hint": "第一次见到用户时赠送的积分",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 1000,
          "step": 5
        },
        "condition": {
          "enable_points": true
        }
      },
      "enable_data_tools": {
        "description": "Bot 数据工具",
        "hint": "允许 LLM 通过 super_draw_data 工具查询和修改积分数据",
        "type": "bool",
        "default": true
      }
    }
  },
  "commentary": {
    "description": "生图后评价",
    "hint": "仅在 LLM 工具调用 super_draw 生图成功后触发，用户命令生图不触发",
    "type": "object",
    "items": {
      "enable_commentary": {
        "description": "启用工具生图后评价",
        "hint": "Bot 通过工具生图成功后，会结合上下文自然评价图片",
        "type": "bool",
        "default": true
      },
      "commentary_provider_id": {
        "description": "生图后评价模型",
        "hint": "选择 AstrBot 已配置的聊天模型；留空使用当前会话模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "condition": {
          "enable_commentary": true
        }
      },
      "commentary_template": {
        "description": "生图后评价模板",
        "hint": "可用变量：{prompt} 用户需求、{model} 生图模型、{context} 会话历史、{images} 图片信息、{max_length} 最大字数",
        "type": "text",
        "default": "你是群聊里的 Bot，刚刚完成了一次生图。结合群聊上下文和用户需求，自然接一句短回复。\n用户需求：{prompt}\n使用模型：{model}\n群聊上下文：\n{context}\n图片信息：\n{images}\n要求：最多 {max_length} 字，接续之前发起请求的人的那种回复，尽可能的模仿群友说话风格，根据上下文。",
        "condition": {
          "enable_commentary": true
        }
      },
      "commentary_max_length": {
        "description": "生图后评价最大字数",
        "hint": "控制 Bot 追评长度，避免刷屏",
        "type": "int",
        "default": 150,
        "slider": {
          "min": 20,
          "max": 500,
          "step": 10
        },
        "condition": {
          "enable_commentary": true
        }
      }
    }
  },
  "presets": {
    "description": "预设配置",
    "hint": "预设提示词，用户可通过 /生图预设 管理，也可在此处预配置",
    "type": "template_list",
    "templates": {
      "preset": {
        "name": "预设项",
        "display_item": "name",
        "items": {
          "name": {
            "description": "预设名称",
            "hint": "用户输入 /生图 预设名称 描述 时会自动套用",
            "type": "string",
            "default": ""
          },
          "prompt": {
            "description": "提示词内容",
            "hint": "预设的完整提示词，会追加在用户描述前面",
            "type": "text",
            "default": ""
          }
        }
      }
    }
  }
}
